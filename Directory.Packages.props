<Project>
  <PropertyGroup>
    <!-- Enables central package version management across all projects -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Prevent individual projects from overriding versions declared here -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup Label="Build Tools">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Orleans">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>
  <ItemGroup Label="Orleans-Test">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Orleans-General">
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup Label="Orleans-Silo">
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Dashboard" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.Redis" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Redis" Version="10.3.1" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.4" />
  </ItemGroup>
  <ItemGroup Label="Orleans-Client">
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup Label="Aspire-Orleans">
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.4" />
  </ItemGroup>
</Project>
