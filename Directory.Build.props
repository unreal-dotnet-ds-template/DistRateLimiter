<Project>

  <PropertyGroup>
    <!-- Target framework — change here to upgrade all projects -->
    <TargetFramework>net9.0</TargetFramework>

    <!-- Language and nullability -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Reproducible / deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package metadata (override per-project as needed) -->
    <Authors>YourName</Authors>
    <Company>YourCompany</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) $(Company)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Analyzer settings -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Source link: embeds git source info into PDBs for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>

    <!-- MinVer: tag prefix and default pre-release label -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- MinVer: automatic semantic versioning from git tags (e.g. v1.2.3) -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
